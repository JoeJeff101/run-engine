# Copy to .env and fill in. Every key here is OPTIONAL.
#
# The pipeline is designed to run with none of them: the four keyless sources
# (OpenAlex, Europe PMC, Crossref, Semantic Scholar) cover discovery, and every
# key-gated connector degrades to "skip with a warning" rather than crashing.
#
# Never commit .env. Never paste a key into source, a test fixture, or a log line.

# --- Politeness identity -------------------------------------------------
# Crossref and OpenAlex give faster, more reliable service to requests that
# identify a contact address ("polite pool"). Optional but recommended.
CONTACT_EMAIL=

# --- Keyless sources: no key required, but a key raises your rate limit ---
S2_API_KEY=
NCBI_API_KEY=

# --- Key-gated sources ---------------------------------------------------
CORE_API_KEY=
PATENTSVIEW_API_KEY=

# --- Optional: embedding-based topic dedup -------------------------------
# Without this, dedup falls back to identifier + normalized-title matching.
OPENAI_API_KEY=

# --- Optional: private leak-scan denylist --------------------------------
# Path to a newline-delimited list of terms that must never appear in this
# repo. Deliberately NOT stored in the repo: a file enumerating the terms you
# are trying to protect is itself a disclosure. See scripts/scan_for_leaks.py.
LEAK_DENYLIST=
